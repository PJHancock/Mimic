<mujoco model="panda pick-place tabletop scene">
  <!-- The pinned Menagerie Panda remains unmodified and is fetched separately. -->
  <include file="franka_emika_panda/upstream/panda.xml"/>
  <compiler angle="radian" meshdir="franka_emika_panda/upstream/assets" autolimits="true"/>

  <statistic center="0.30 0 0.35" extent="0.85"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <asset>
    <texture name="groundplane" type="2d" builtin="checker" rgb1="0.20 0.30 0.40"
      rgb2="0.10 0.20 0.30" width="300" height="300" mark="edge" markrgb="0.8 0.8 0.8"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2"/>
    <material name="tabletop_material" rgba="0.62 0.45 0.30 1"/>
    <material name="cube_material" rgba="0.80 0.10 0.10 1"/>
  </asset>

  <worldbody>
    <light name="scene_key" pos="0.3 -0.5 1.3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" pos="0 0 -0.01"/>

    <!-- Table near edge is 0.15 m in front of the Panda base; table axes map to
         +world X and -world Y. -->
    <geom name="tabletop_clone" type="box" pos="0.404 0 -0.005"
      size="0.254 0.381 0.005" material="tabletop_material"/>
    <site name="robot_base_frame" type="sphere" pos="0 0 0" size="0.005"
      rgba="1 0 0 1"/>

    <!-- Simulation-default 4 cm, 30 g object; center rests 2 cm above the tabletop. -->
    <body name="cube" pos="0.30 0 0.02">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.02 0.02 0.02" mass="0.03"
        material="cube_material"/>
    </body>
  </worldbody>

  <!-- Full nq=16 reset: 7 arm + 2 fingers + cube free-joint pose. -->
  <keyframe>
    <key name="pick_place_home"
      qpos="0 0 0 -1.57079 0 1.57079 -0.7853 0.04 0.04 0.30 0 0.02 1 0 0 0"
      ctrl="0 0 0 -1.57079 0 1.57079 -0.7853 255"/>
  </keyframe>
</mujoco>
